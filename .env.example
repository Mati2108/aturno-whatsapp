
# --- Twilio WhatsApp Sandbox ---
# Consola de Twilio -> Account Dashboard -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
# El número del sandbox, en formato E.164 (sin el prefijo "whatsapp:")
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Observabilidad (Arize Phoenix) ---
# Levantá Phoenix con:  ./venv/bin/phoenix serve
PHOENIX_HABILITADO=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Embeddings: "api" (Gemini, no consume memoria) | "local" (fastembed, +805 MB)
EMBEDDINGS_MODO=api

# A quién recurrir si el proveedor principal no contesta. Lista separada por
# comas, en orden; vacío apaga el respaldo.
#
# Existe porque pasó: se acabó el crédito de la cuenta de Anthropic y el
# clasificador falló en TODOS los mensajes. El bot seguía contestando HTTP pero
# no entendía nada, y como el paso del nombre depende del modelo, ningún cliente
# nuevo podía sacar turno. La clave era válida, así que ningún chequeo de
# credenciales lo agarraba.
#
# Gemini por defecto y no otro: lo que hay que cubrir es que se corte la
# facturación, y dos proveedores pagados con la misma tarjeta se caen juntos.
# Además su clave ya es obligatoria para los embeddings, así que el respaldo
# está disponible por construcción. Un proveedor sin clave se saltea solo.
PROVIDER_RESPALDO=gemini
