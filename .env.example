
# --- Twilio WhatsApp Sandbox ---
# Consola de Twilio -> Account Dashboard -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
# El número del sandbox, en formato E.164 (sin el prefijo "whatsapp:")
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Observabilidad (Arize Phoenix) ---
# Levantá Phoenix con:  ./venv/bin/phoenix serve
PHOENIX_HABILITADO=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Embeddings: "api" (Gemini, no consume memoria) | "local" (fastembed, +805 MB)
EMBEDDINGS_MODO=api
